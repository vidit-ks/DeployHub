# DeployHub Backend Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL) - Optional: DeployHub includes persistent fallback
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deployhub
# PGUSER=postgres
# PGPASSWORD=postgres
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=deployhub

# Google Gemini AI - For AI Error Doctor diagnosis
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Integration - Optional: For private repos and higher rate limits
GITHUB_TOKEN=your_github_personal_access_token_here
